#!/bin/bash
# .git/hooks/pre-commit — 受保护文件角色门（v3.6）
# 由 ai-dev-flow-server install.sh 部署；role/trace 段与 pre-push 自包含重复（单文件自包含 > DRY）
# v2 一律冠名"Agent B"误导（人与 AI 同 unix 用户，钩子层无法分辨驱动者）——
# 现按 .devflow/config.yaml 的 role + OWNER_SESSION=1 双因子判定，决策写 gitdir 留痕可审计。

PROTECTED_PATTERNS=".devflow/|.github/workflows/|Dockerfile|docker-compose|systemd|nginx|Makefile|CLAUDE.md|install.sh|uninstall.sh|_handoff/inbox/|_handoff/README.md|_handoff/TEMPLATE.md|_agentlocks/"

STAGED=$(git diff --cached --name-only)
PROTECTED_FILES=$(echo "$STAGED" | grep -E "$PROTECTED_PATTERNS" || true)
[ -z "$PROTECTED_FILES" ] && exit 0

ROLE=""
CFG=".devflow/config.yaml"
if [ -f "$CFG" ]; then
    ROLE=$(grep -E '^[[:space:]]*role:' "$CFG" 2>/dev/null | head -1 \
        | sed 's/.*role:[[:space:]]*//; s/[[:space:]]*#.*$//; s/[[:space:]]*$//' | tr -d '"' || true)
fi
[ -z "$ROLE" ] && ROLE="agent-b"

GD=$(git rev-parse --git-common-dir 2>/dev/null || true)
trace() {  # trace <event>——写 gitdir 内（不被跟踪、全 worktree 汇聚），失败静默
    [ -n "$GD" ] || return 0
    printf '{"ts":"%s","hook":"pre-commit","event":"%s","role":"%s"}\n' \
        "$(date +%FT%T 2>/dev/null)" "$1" "$ROLE" \
        >> "$GD/devflow-trace.jsonl" 2>/dev/null || true
}

if [ "$ROLE" = "owner" ] && [ "${OWNER_SESSION:-}" = "1" ]; then
    trace "owner-bypass"
    echo "ℹ️  owner 授权提交受保护文件（OWNER_SESSION=1，已留痕）："
    echo "$PROTECTED_FILES" | sed 's/^/    /'
    exit 0
fi

trace "blocked"
echo "⛔ 以下文件受 DevFlow 管线保护（policy: role=$ROLE）："
echo "$PROTECTED_FILES"
echo "   owner 会话: OWNER_SESSION=1 git commit（留痕审计）  |  agent-b: 写 _handoff/outbox/agent-b/ 委托 A"
exit 1
